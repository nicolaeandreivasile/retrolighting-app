	(text "LED Driver\n"
		(exclude_from_sim no)
		(at 148.59 25.4 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "f2d1abbe-0bf2-497e-b80f-1c0cae65c2e3")
	)
	(text_box "LED Driver	\n\n	The LED driver used for this prototype is TLC59108IPWR. The chosen LEDs are GW VJLPL1.EM-LXL3-XX53-1-350-R18 (white) and GR VJLPL1.23-KQKS-A4R2-1-350-R18 (red).\n	BHR-06-VUA (main & led board) and FCS-06-SG + 3365/06 (connecting calbe) are used for connectivity.\n	The setup has HW configurable I2C address and forward LED currents.\n\n	For contant current accross the LEDs, the following formula is used to compute the Rext for default configuration:	\n	- VREXT = 1.26 V × 127/128 = 1.25 V\n	- IOUT,target = (1.25 V/Rext) × 15\n"
		(exclude_from_sim no)
		(at 203.2 17.78 0)
		(size 76.2 29.21)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "95566367-c42c-4660-88cf-6e3aed131251")
	)
